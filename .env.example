# Central Passport host: Nexus, login, registration, redirects, and Wizard.
PASSPORT_HOST=passport-staging.lunastore.app

# Profile/help host advertised through PassportURLs.
MEMBERSERVICES_HOST=memberservices-staging.lunastore.app

# Shared parent domain for MSPAuth/MSPProf cookies.
PASSPORT_COOKIE_DOMAIN=.lunastore.app

# Pepper for hashing OAuth client secrets (lab default is used if empty).
OAUTH_SECRET_PEPPER=
