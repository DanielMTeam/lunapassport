Windows Registry Editor Version 5.00

; Windows XP Passport configuration.
; Replace passport-staging.alexsyw.me with the host used by PASSPORT_HOST.
; Replace passport-staging.alexsyw.me and memberservices-staging.alexsyw.me
; in this section when adapting the file to another environment.
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Internet Settings\Passport]
"ConfigVersion"=dword:00000011
"GeneralRedir"="https://passport-staging.alexsyw.me/redir.asp"
"Help"="https://memberservices-staging.alexsyw.me/UI/MSRV_UI_Help.asp"
"LoginServerRealm"="Passport.Net"
"LoginServerUrl"="https://passport-staging.alexsyw.me/login2.asp"
"Privacy"="https://passport-staging.alexsyw.me/consumer/privacypolicy.asp"
"Properties"="https://memberservices-staging.alexsyw.me/ppsecure/MSRV_EditProfile.asp"
"RegistrationUrl"="https://passport-staging.alexsyw.me/defaultwiz.asp"
