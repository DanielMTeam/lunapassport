Windows Registry Editor Version 5.00

; Local lab using the same hostnames as passport-test.reg / README staging.
; Point these names at your LunaPassport machine in XP hosts, for example:
;   192.168.1.11 passport-staging.alexsyw.me memberservices-staging.alexsyw.me
;
; Then on the Windows host running Go:
;   go run .\cmd\lunapassport -http :8080 `
;     -passport-host passport-staging.alexsyw.me `
;     -memberservices-host memberservices-staging.alexsyw.me `
;     -passport-cookie-domain .alexsyw.me
;   go run .\cmd\tlspproxy   (elevated)
;
; Trust _data\passport-mock.crt on XP after scripts\gen-local-certs.ps1.
; Real DNS / access to alexsyw.me is not required when hosts overrides the names.

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Internet Settings\Passport]
"ConfigVersion"=dword:00000011
"GeneralRedir"="https://passport-staging.alexsyw.me/redir.asp"
"Help"="https://memberservices-staging.alexsyw.me/UI/MSRV_UI_Help.asp"
"LoginServerRealm"="Passport.Net"
"LoginServerUrl"="https://passport-staging.alexsyw.me/login2.asp"
"Privacy"="https://passport-staging.alexsyw.me/consumer/privacypolicy.asp"
"Properties"="https://memberservices-staging.alexsyw.me/ppsecure/MSRV_EditProfile.asp"
"RegistrationUrl"="https://passport-staging.alexsyw.me/defaultwiz.asp"

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Internet Settings\WinHttp\Passport Test]
"LoginServerRealm"="Passport.Net"
"LoginServerUrl"="https://passport-staging.alexsyw.me/login2.asp"
"ConfigVersion"=dword:00000011
"NexusHost"="passport-staging.alexsyw.me"
"NexusObj"="rdr/pprdr.asp"
