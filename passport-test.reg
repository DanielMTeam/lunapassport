Windows Registry Editor Version 5.00

; LunaPassport Windows XP Passport configuration.
; Import this file on the isolated XP test machine.
; XP Passport Manager and the native Wizard read the resolved Passport URLs here.
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Internet Settings\Passport]
"ConfigVersion"=dword:00000011
"GeneralRedir"="https://passport-staging.lunastore.app/redir.asp"
"Help"="https://memberservices-staging.lunastore.app/UI/MSRV_UI_Help.asp"
"LoginServerRealm"="Passport.Net"
"LoginServerUrl"="https://passport-staging.lunastore.app/login2.asp"
"Privacy"="https://passport-staging.lunastore.app/consumer/privacypolicy.asp"
"Properties"="https://memberservices-staging.lunastore.app/ppsecure/MSRV_EditProfile.asp"
"RegistrationUrl"="https://passport-staging.lunastore.app/defaultwiz.asp"
